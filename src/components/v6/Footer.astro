---
/** V6 · Čistá voda footer. Same facts and © line as V1–V5; every link is a ≥ 44 px target. */
import Icon from '../shared/Icon.astro';
import { site } from '../../lib/content';
import { url } from '../../lib/url';
const links = [
  { href: '#hodiny', label: 'Otváracie hodiny' },
  { href: '#ceny', label: 'Cenník' },
  { href: '#rezervacie', label: 'Rezervácie' },
  { href: '#v6-fff', label: 'FotoFilmFest' },
  { href: '#galeria', label: 'Galéria' },
  { href: url('/o-nas/'), label: 'O nás' },
];
const { info, dive } = site.contacts;
const li = 'v6-link inline-flex min-h-11 items-center';
---
<footer class="on-dark bg-[var(--v6-hlbka)] pb-24 text-[#e7f1f1] md:pb-10">
  <div class="v6-wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="v6-display text-xl font-bold text-white">Kontakt</h2>
      <p class="mt-3 text-[0.9375rem] text-[#b9cfd2]">{info.label}</p>
      <p><a class="v6-num inline-flex min-h-11 items-center text-lg font-bold text-white hover:underline" href={`tel:${info.tel}`}>{info.phone}</a><br /><a class={`${li} text-[#e7f1f1]`} href={`mailto:${info.email}`}>{info.email}</a></p>
      <p class="mt-3 text-[0.9375rem] text-[#b9cfd2]">{dive.label}</p>
      <p><a class="v6-num inline-flex min-h-11 items-center text-lg font-bold text-white hover:underline" href={`tel:${dive.tel}`}>{dive.phone}</a><br /><a class={`${li} text-[#e7f1f1]`} href={`mailto:${dive.email}`}>{dive.email}</a></p>
    </div>
    <div>
      <h2 class="v6-display text-xl font-bold text-white">Adresa</h2>
      <address class="mt-3 not-italic">{site.address.lines.map((l) => <span class="block">{l}</span>)}</address>
      <p class="v6-num mt-1 text-[0.9375rem] text-[#b9cfd2]">GPS {site.address.lat}, {site.address.lng}</p>
    </div>
    <div>
      <h2 class="v6-display text-xl font-bold text-white">Odkazy</h2>
      <ul class="mt-2" role="list">{links.map((l) => <li><a class={`${li} text-[#e7f1f1]`} href={l.href}>{l.label}</a></li>)}</ul>
      <ul class="mt-4 flex flex-wrap gap-3" role="list">
        {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 font-semibold text-white ring-1 ring-white/40 hover:bg-white/10"><Icon name={s.label === 'Facebook' ? 'facebook' : 'instagram'} size={18} />{s.label}<span class="sr-only"> (otvorí sa v novom okne)</span></a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="v6-display text-xl font-bold text-white">Dokumenty</h2>
      <ul class="mt-2" role="list">
        {site.documents.slice(0, 3).map((d) => <li><a class={`${li} text-[#e7f1f1]`} href={d.href} target="_blank" rel="noopener">{d.label}<span class="sr-only"> ({d.file}, otvorí sa v novom okne)</span></a></li>)}
      </ul>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-[#b9cfd2]">{site.operator.name}, {site.operator.street}, {site.operator.city}, IČO {site.operator.ico}</p>
    </div>
  </div>
  <p class="v6-wrap border-t border-white/15 pt-6 text-[0.9375rem] text-[#b9cfd2]">Koncept redizajnu, neoficiálna verzia. Obsah, fotografie a logo © {site.operator.name}. Aktuálne informácie na <a class="v6-link text-[#e7f1f1]" href="https://www.aquarea.sk/">aquarea.sk</a>. Slovenská verzia, anglická a maďarská sa doplnia v ďalšej fáze.</p>
</footer>
