---
/** V6 · Čistá voda: sticky header, 5 items + Rezervovať. Phone menu is a disclosure (aria-expanded), Esc closes it. */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import Icon from '../shared/Icon.astro';
import { site } from '../../lib/content';
import { url } from '../../lib/url';

interface Props { bookHref?: string }
const { bookHref = url('/rezervacie/') } = Astro.props;
const nav = [
  { href: url('/plazova-zona/'), label: 'Pláž' },
  { href: url('/premium-zona/'), label: 'Pobyt' },
  { href: url('/potapanie/'), label: 'Potápanie' },
  { href: url('/cennik/'), label: 'Cenník' },
  { href: url('/kontakt/'), label: 'Kontakt' },
];
---
<header class="v6-header">
  <div class="m-progress" aria-hidden="true"></div>
  <div class="v6-wrap flex h-16 items-center gap-2 md:h-[4.5rem] md:gap-4">
    <a href={url('/')} class="mr-auto inline-flex min-h-11 items-center rounded-md" aria-label="Aquarea Čierna Voda, úvod">
      <Image src={logo} alt="" width={150} height={56} class="h-9 w-auto md:h-11" loading="eager" />
    </a>
    <nav aria-label="Hlavná navigácia" class="v6-nav hidden lg:block">
      <ul class="flex items-center gap-1" role="list">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <a href={`tel:${site.contacts.info.tel}`} class="v6-btn hidden !min-h-11 md:inline-flex"><Icon name="phone" size={18} />Zavolať</a>
    <a href={bookHref} class="v6-cta hidden !min-h-11 md:inline-flex">Rezervovať</a>
    <a href={`tel:${site.contacts.info.tel}`} class="v6-iconbtn md:hidden"><Icon name="phone" size={22} /><span class="sr-only">Zavolať {site.contacts.info.phone}</span></a>
    <button type="button" class="v6-iconbtn v6-menu-btn lg:hidden" aria-expanded="false" aria-controls="v6-menu">
      <Icon name="menu" size={24} class="v6-open" /><Icon name="x" size={24} class="v6-close hidden" /><span class="sr-only">Menu</span>
    </button>
  </div>
  <div id="v6-menu" class="hidden border-t border-[var(--v6-ciara)] bg-[var(--v6-svetlo)] lg:hidden">
    <nav aria-label="Hlavná navigácia (mobil)" class="v6-wrap py-3">
      <ul class="grid" role="list">
        {nav.map((n) => <li><a href={n.href} class="v6-display flex min-h-12 items-center text-2xl font-semibold">{n.label}</a></li>)}
      </ul>
      <p class="mt-2 flex flex-wrap gap-x-6 pb-2">
        <a class="v6-link inline-flex min-h-11 items-center" href={url('/otvaracie-hodiny/')}>Otváracie hodiny</a>
        <a class="v6-link inline-flex min-h-11 items-center" href={url('/fotofilmfest/')}>FotoFilmFest</a>
        <a class="v6-link inline-flex min-h-11 items-center" href={url('/galeria/')}>Galéria</a>
      </p>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.v6-menu-btn');
  const menu = document.getElementById('v6-menu');
  const toggle = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    btn?.querySelector('.v6-open')?.classList.toggle('hidden', open);
    btn?.querySelector('.v6-close')?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => toggle(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { toggle(false); btn.focus(); }
  });
</script>
