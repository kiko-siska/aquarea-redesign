---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import Icon from '../shared/Icon.astro';
import { url } from '../../lib/url';

interface Props { current?: string; bookHref?: string }
const { current, bookHref = '#rezervacie' } = Astro.props;
const nav = [
  { href: '#v3-zones', label: 'Pláž', id: 'plaz', color: 'bg-v3-plaz' },
  { href: '#v3-zones', label: 'Pobyt', id: 'pobyt', color: 'bg-v3-premium' },
  { href: '#v3-zones', label: 'Potápanie', id: 'potapanie', color: 'bg-v3-dive' },
  { href: '#v3-prices', label: 'Cenník', id: 'cennik', color: 'bg-v3-slnko' },
  { href: '#rezervacie', label: 'Kontakt', id: 'kontakt', color: 'bg-v3-event' },
];
---
<header class="sticky top-0 z-50 bg-white shadow-[0_1px_0_#10212b1a]">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center gap-3 px-4 md:h-20 md:px-8">
    <a href={url('/variants/3/')} class="mr-auto flex items-center rounded" aria-label="Aquarea Čierna Voda – úvod">
      <Image src={logo} alt="" width={150} height={56} class="h-10 w-auto md:h-12" loading="eager" />
    </a>
    <nav aria-label="Hlavná navigácia" class="hidden lg:block">
      <ul class="flex items-center gap-1" role="list">
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={current === n.id ? 'page' : undefined} class="group flex items-center gap-2 rounded-lg px-3 py-2.5 font-v3-sans text-[0.9375rem] font-bold text-v3-atrament hover:bg-v3-siva">
              <span class:list={['h-3 w-3 rounded-full', n.color]} aria-hidden="true"></span>{n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={bookHref} class="hidden min-h-11 items-center rounded-lg bg-v3-slnko px-5 font-v3-sans font-extrabold text-v3-atrament hover:bg-v3-atrament hover:text-v3-slnko md:inline-flex">Rezervovať</a>
    <button type="button" class="v3-menu-btn inline-flex h-11 w-11 items-center justify-center rounded-lg text-v3-atrament hover:bg-v3-siva lg:hidden" aria-expanded="false" aria-controls="v3-menu">
      <Icon name="menu" size={26} class="v3-open" /><Icon name="x" size={26} class="v3-close hidden" /><span class="sr-only">Menu</span>
    </button>
  </div>
  <div id="v3-menu" class="hidden border-t border-v3-atrament/10 bg-white lg:hidden">
    <nav aria-label="Hlavná navigácia (mobil)">
      <ul class="mx-auto grid max-w-[90rem] gap-2 px-4 py-4" role="list">
        {nav.map((n) => (
          <li><a href={n.href} class="flex items-center gap-3 rounded-lg bg-v3-siva px-4 py-3 font-v3-display text-[1.9rem] font-extrabold uppercase leading-none text-v3-atrament"><span class:list={['h-4 w-4 rounded-full', n.color]} aria-hidden="true"></span>{n.label}</a></li>
        ))}
        <li class="flex flex-wrap gap-x-5 gap-y-2 px-1 pt-2 font-v3-sans font-semibold">
          <a href={'#v3-hours'} class="underline underline-offset-4">Otváracie hodiny</a>
          <a href={'#v3-fff'} class="underline underline-offset-4">FotoFilmFest</a>
          <a href={'#v3-gal'} class="underline underline-offset-4">Galéria</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.v3-menu-btn');
  const menu = document.getElementById('v3-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
    btn.querySelector('.v3-open')?.classList.toggle('hidden', !open);
    btn.querySelector('.v3-close')?.classList.toggle('hidden', open);
  });
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a') && btn?.getAttribute('aria-expanded') === 'true') btn.click(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { btn.click(); btn.focus(); } });
</script>
