---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import Icon from '../shared/Icon.astro';
import { url } from '../../lib/url';

interface Props { current?: string; bookHref?: string }
const { current, bookHref = '#rezervacie' } = Astro.props;
const nav = [
  { href: '#v2-zones', label: 'Pláž', id: 'plaz' },
  { href: '#v2-zones', label: 'Pobyt', id: 'pobyt' },
  { href: '#v2-zones', label: 'Potápanie', id: 'potapanie' },
  { href: '#cennik', label: 'Cenník', id: 'cennik' },
  { href: '#rezervacie', label: 'Kontakt', id: 'kontakt' },
];
---
<header class="sticky top-0 z-50 border-b border-v2-atrament/15 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[84rem] items-center gap-4 px-4 md:h-[4.5rem] md:px-8">
    <a href={url('/variants/2/')} class="mr-auto flex items-center rounded" aria-label="Aquarea Čierna Voda – úvod">
      <Image src={logo} alt="" width={150} height={56} class="h-10 w-auto md:h-11" loading="eager" />
    </a>
    <nav aria-label="Hlavná navigácia" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-v2-sans text-[0.9375rem] font-medium" role="list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current === n.id ? 'page' : undefined} class="py-2 text-v2-atrament underline-offset-[6px] hover:underline aria-[current=page]:underline aria-[current=page]:decoration-v2-psenica aria-[current=page]:decoration-2">{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={bookHref} class="hidden min-h-11 items-center rounded-full bg-v2-slnecnik px-5 font-v2-sans text-[0.9375rem] font-semibold text-white hover:bg-v2-slnecnik-tmavy md:inline-flex">Rezervovať</a>
    <button type="button" class="v2-menu-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-v2-atrament hover:bg-v2-obloha lg:hidden" aria-expanded="false" aria-controls="v2-menu">
      <Icon name="menu" size={24} class="v2-open" /><Icon name="x" size={24} class="v2-close hidden" /><span class="sr-only">Menu</span>
    </button>
  </div>
  <div id="v2-menu" class="hidden border-t border-v2-atrament/15 bg-white lg:hidden">
    <nav aria-label="Hlavná navigácia (mobil)">
      <ul class="mx-auto max-w-[84rem] px-4 pb-4 pt-2" role="list">
        {nav.map((n) => <li><a href={n.href} class="block border-b border-v2-atrament/10 py-3.5 font-v2-serif text-[1.65rem] text-v2-atrament">{n.label}</a></li>)}
        <li><a href={'#v2-day'} class="block border-b border-v2-atrament/10 py-3 font-v2-sans text-lg text-v2-atrament">Otváracie hodiny</a></li>
        <li><a href={'#v2-fff'} class="block border-b border-v2-atrament/10 py-3 font-v2-sans text-lg text-v2-atrament">FotoFilmFest</a></li>
        <li><a href={'#v2-gal'} class="block py-3 font-v2-sans text-lg text-v2-atrament">Galéria</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.v2-menu-btn');
  const menu = document.getElementById('v2-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
    btn.querySelector('.v2-open')?.classList.toggle('hidden', !open);
    btn.querySelector('.v2-close')?.classList.toggle('hidden', open);
  });
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a') && btn?.getAttribute('aria-expanded') === 'true') btn.click(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { btn.click(); btn.focus(); } });
</script>
