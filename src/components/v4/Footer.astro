---
/** V4 · Čierna voda footer: the lake floor. Same facts and © line as V1–V3. */
import Icon from '../shared/Icon.astro';
import { site } from '../../lib/content';
import { url } from '../../lib/url';
const links = [
  { href: '#v4-hours', label: 'Otváracie hodiny' },
  { href: '#ceny', label: 'Cenník' },
  { href: '#rezervacie', label: 'Rezervácie' },
  { href: '#v4-fff', label: 'FotoFilmFest' },
  { href: '#v4-gal', label: 'Galéria' },
  { href: url('/o-nas/'), label: 'O nás' },
];
const { info, dive } = site.contacts;
---
<footer class="relative z-[2] bg-[var(--v4-hlbka)] pb-24 text-[var(--v4-hmla)] md:pb-10">
  <div class="v4-wrap grid gap-10 border-t border-white/10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="v4-display text-xl">Kontakt</h2>
      <p class="mt-3 text-sm text-[var(--v4-studena)]">{info.label}</p>
      <p><a class="v4-num text-lg font-semibold hover:text-[var(--v4-baterka)]" href={`tel:${info.tel}`}>{info.phone}</a><br /><a class="v4-link" href={`mailto:${info.email}`}>{info.email}</a></p>
      <p class="mt-3 text-sm text-[var(--v4-studena)]">{dive.label}</p>
      <p><a class="v4-num text-lg font-semibold hover:text-[var(--v4-baterka)]" href={`tel:${dive.tel}`}>{dive.phone}</a><br /><a class="v4-link" href={`mailto:${dive.email}`}>{dive.email}</a></p>
    </div>
    <div>
      <h2 class="v4-display text-xl">Adresa</h2>
      <address class="mt-3 not-italic">{site.address.lines.map((l) => <span class="block">{l}</span>)}</address>
      <p class="v4-num mt-1 text-sm text-[var(--v4-studena)]">GPS {site.address.lat}, {site.address.lng}</p>
    </div>
    <div>
      <h2 class="v4-display text-xl">Odkazy</h2>
      <ul class="mt-3 space-y-1.5" role="list">{links.map((l) => <li><a class="v4-link" href={l.href}>{l.label}</a></li>)}</ul>
      <ul class="mt-5 flex gap-3" role="list">
        {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="v4-ghost !min-h-11 !px-4 text-sm"><Icon name={s.label === 'Facebook' ? 'facebook' : 'instagram'} size={18} />{s.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="v4-display text-xl">Dokumenty</h2>
      <ul class="mt-3 space-y-1.5" role="list">
        {site.documents.slice(0, 3).map((d) => <li><a class="v4-link" href={d.href} target="_blank" rel="noopener">{d.label}</a> <span class="text-sm text-[var(--v4-studena)]">({d.file})</span></li>)}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-[var(--v4-studena)]">{site.operator.name}, {site.operator.street}, {site.operator.city}, IČO {site.operator.ico}</p>
    </div>
  </div>
  <p class="v4-wrap border-t border-white/10 pt-6 text-sm text-[var(--v4-studena)]">Koncept redizajnu, neoficiálna verzia. Obsah, fotografie a logo © {site.operator.name}. Aktuálne informácie na <a class="v4-link" href="https://www.aquarea.sk/">aquarea.sk</a>. Slovenská verzia, anglická a maďarská sa doplnia v ďalšej fáze.</p>
</footer>
