---
/** V7 · Rýchla voda: sticky header, 5 items + Rezervovať. Phone menu is a disclosure (aria-expanded), Esc closes it. */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import wordmark from '../../assets/brand/logo-wordmark.png';
import diver from '../../assets/brand/logo-diver.png';
import Icon from '../shared/Icon.astro';
import { site } from '../../lib/content';
import { url } from '../../lib/url';

/** split: the logo cut in two (owner 2026-10-31): name + tagline on the left, the Dive Center badge on the right. */
interface Props { bookHref?: string; split?: boolean }
const { bookHref = '#rezervacie', split = false } = Astro.props;
const nav = [
  { href: '#zony', label: 'Pláž' },
  { href: '#zony', label: 'Pobyt' },
  { href: '#v7-dive', label: 'Potápanie' },
  { href: '#ceny', label: 'Cenník' },
  { href: '#rezervacie', label: 'Kontakt' },
];
---
<header class="v7-header">
  {split && <noscript><style>.cta-dock{grid-template-columns:1fr;opacity:1;visibility:visible;transform:none}</style></noscript>}
  <div class="m-progress" aria-hidden="true"></div>
  <div class="v7-wrap flex h-16 items-center gap-2 md:h-[4.5rem] md:gap-4">
    <a href="./" class="mr-auto inline-flex min-h-11 items-center rounded-md" aria-label="Aquarea Čierna Voda, úvod">
      {split
        ? <Image src={wordmark} alt="" width={172} height={88} class="h-10 w-auto md:h-12" loading="eager" />
        : <Image src={logo} alt="" width={150} height={56} class="h-9 w-auto md:h-11" loading="eager" />}
    </a>
    <nav aria-label="Hlavná navigácia" class="v7-nav hidden lg:block">
      <ul class="flex items-center gap-1" role="list">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div class:list={[split ? 'cta-dock' : 'contents']}><div class:list={[split ? 'cta-dock-clip' : 'contents']}><div class:list={[split ? 'cta-dock-pad' : 'contents']}>
      <a href={`tel:${site.contacts.info.tel}`} class="v7-btn hidden !min-h-11 md:inline-flex"><Icon name="phone" size={18} />Zavolať</a>
      <a href={bookHref} class="v7-cta hidden !min-h-11 md:inline-flex">Rezervovať</a>
    </div></div></div>
    <a href={`tel:${site.contacts.info.tel}`} class="v7-iconbtn md:hidden"><Icon name="phone" size={22} /><span class="sr-only">Zavolať {site.contacts.info.phone}</span></a>
    <button type="button" class="v7-iconbtn v7-menu-btn lg:hidden" aria-expanded="false" aria-controls="v7-menu">
      <Icon name="menu" size={24} class="v7-open" /><Icon name="x" size={24} class="v7-close hidden" /><span class="sr-only">Menu</span>
    </button>
    {split && (
      <a href="#v7-dive" class="inline-flex min-h-11 shrink-0 items-center rounded-md" aria-label="Aquarea Dive Center, potápanie">
        <Image src={diver} alt="" width={131} height={118} class="h-10 w-auto md:h-12" loading="eager" />
      </a>
    )}
  </div>
  <div id="v7-menu" class="hidden border-t-4 border-[var(--v7-cierna)] bg-white lg:hidden">
    <nav aria-label="Hlavná navigácia (mobil)" class="v7-wrap py-3">
      <ul class="grid" role="list">
        {nav.map((n) => <li><a href={n.href} class="v7-display flex min-h-12 items-center text-3xl uppercase">{n.label}</a></li>)}
      </ul>
      <p class="mt-2 flex flex-wrap gap-x-6 pb-2">
        <a class="v7-link inline-flex min-h-11 items-center" href={'#hodiny'}>Otváracie hodiny</a>
        <a class="v7-link inline-flex min-h-11 items-center" href={'#v7-fff'}>FotoFilmFest</a>
        <a class="v7-link inline-flex min-h-11 items-center" href={'#galeria'}>Galéria</a>
      </p>
    </nav>
  </div>
</header>
<script>
  import { initCtaDock } from '../../lib/ctaDock';
  const btn = document.querySelector<HTMLButtonElement>('.v7-menu-btn');
  const menu = document.getElementById('v7-menu');
  const toggle = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    btn?.querySelector('.v7-open')?.classList.toggle('hidden', open);
    btn?.querySelector('.v7-close')?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => toggle(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) toggle(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { toggle(false); btn.focus(); }
  });
  initCtaDock(document.querySelector<HTMLElement>('header:has(.cta-dock)'));
</script>
