---
/** Coloured page header in the zone colour, with breadcrumbs and an optional real photo. */
import Photo from '../shared/Photo.astro';
import Icon from '../shared/Icon.astro';
import { url } from '../../lib/url';

interface Props {
  title: string;
  lead?: string;
  zone?: 'plaz' | 'premium' | 'dive' | 'event' | 'slnko' | 'atrament';
  photo?: string;
  crumb: string;
}
const { title, lead, zone = 'atrament', photo, crumb } = Astro.props;
---
<header class:list={['v3-weave zone-fill', `zone-${zone}`]}>
  <div class:list={['mx-auto grid max-w-[90rem] gap-6 px-4 pb-10 pt-6 md:px-8 md:pb-14 md:pt-8', photo && 'lg:grid-cols-[1.2fr_1fr] lg:items-end lg:gap-12']}>
    <div>
      <nav aria-label="Omrvinky" class="text-sm font-semibold">
        <ol class="flex flex-wrap items-center gap-1.5" role="list">
          <li><a href={url('/')} class="underline underline-offset-4 hover:no-underline">Úvod</a></li>
          <li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
          <li aria-current="page">{crumb}</li>
        </ol>
      </nav>
      <h1 class="v3-display mt-4 text-[3rem] leading-[0.92] xs:text-[3.6rem] md:text-[5.5rem] lg:text-[6.5rem]">{title}</h1>
      {lead && <p class="mt-4 max-w-2xl text-lg font-medium leading-relaxed md:text-xl">{lead}</p>}
      <slot />
    </div>
    {photo && (
      <Photo id={photo} priority sizes="(min-width: 1024px) 42vw, 100vw" widths={[480, 800, 1100]} class="aspect-[4/3] w-full rounded-lg object-cover shadow-[0_20px_40px_-24px_rgb(16_33_43/0.6)]" />
    )}
  </div>
</header>
