---
/** V10 · Mapa z výšky: sticky header, 5 tabs + Zavolať / Rezervovať. Every tab scrolls inside the variant (DECISIONS 2026-10-05). */
import { Image } from 'astro:assets';
import wordmark from '../../assets/brand/logo-wordmark.png';
import diver from '../../assets/brand/logo-diver.png';
import Icon from '../shared/Icon.astro';
import { site } from '../../lib/content';

interface Props { bookHref?: string }
const { bookHref = '#rezervacie' } = Astro.props;
const nav = [
  { href: '#plaz', label: 'Pláž' },
  { href: '#pobyt', label: 'Pobyt' },
  { href: '#potapanie', label: 'Potápanie' },
  { href: '#ceny', label: 'Cenník' },
  { href: '#rezervacie', label: 'Kontakt' },
];
---
<header class="v10-header">
  <noscript><style>.cta-dock{grid-template-columns:1fr;opacity:1;visibility:visible;transform:none}</style></noscript>
  <div class="m-progress" aria-hidden="true"></div>
  <div class="v10-wrap flex h-16 items-center gap-2 md:h-[4.5rem] md:gap-3 lg:max-w-none lg:px-8">
    <a href="./" class="mr-auto inline-flex min-h-11 items-center rounded-md" aria-label="Aquarea Čierna Voda, úvod">
      <Image src={wordmark} alt="" width={172} height={88} class="h-10 w-auto md:h-12" loading="eager" />
    </a>
    <nav aria-label="Hlavná navigácia" class="v10-nav hidden lg:block">
      <ul class="flex items-center gap-0.5" role="list">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="cta-dock"><div class="cta-dock-clip"><div class="cta-dock-pad">
      <a href={`tel:${site.contacts.info.tel}`} class="v10-btn hidden !min-h-11 md:inline-flex"><Icon name="phone" size={18} />Zavolať</a>
      <a href={bookHref} class="v10-cta hidden !min-h-11 md:inline-flex">Rezervovať</a>
    </div></div></div>
    <a href={`tel:${site.contacts.info.tel}`} class="v10-iconbtn md:hidden"><Icon name="phone" size={22} /><span class="sr-only">Zavolať {site.contacts.info.phone}</span></a>
    <button type="button" class="v10-iconbtn v10-menu-btn lg:hidden" aria-expanded="false" aria-controls="v10-menu">
      <Icon name="menu" size={24} class="v10-open" /><Icon name="x" size={24} class="v10-close hidden" /><span class="sr-only">Menu</span>
    </button>
    <a href="#potapanie" class="inline-flex min-h-11 shrink-0 items-center rounded-md" aria-label="Aquarea Dive Center, potápanie">
      <Image src={diver} alt="" width={131} height={118} class="h-10 w-auto md:h-12" loading="eager" />
    </a>
  </div>
  <div id="v10-menu" class="hidden border-t-2 border-[var(--cierna)] bg-white lg:hidden">
    <nav aria-label="Hlavná navigácia (mobil)" class="v10-wrap py-3">
      <ul class="grid" role="list">
        {nav.map((n) => <li><a href={n.href} class="v10-display flex min-h-12 items-center text-[1.75rem]">{n.label}</a></li>)}
      </ul>
      <p class="mt-2 flex flex-wrap gap-x-6 pb-2">
        <a class="v10-link inline-flex min-h-11 items-center" href="#hodiny">Otváracie hodiny</a>
        <a class="v10-link inline-flex min-h-11 items-center" href="#fff">FotoFilmFest</a>
        <a class="v10-link inline-flex min-h-11 items-center" href="#galeria">Galéria</a>
      </p>
    </nav>
  </div>
</header>
<script>
  import { initCtaDock } from '../../lib/ctaDock';
  const btn = document.querySelector<HTMLButtonElement>('.v10-menu-btn');
  const menu = document.getElementById('v10-menu');
  const toggle = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    btn?.querySelector('.v10-open')?.classList.toggle('hidden', open);
    btn?.querySelector('.v10-close')?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => toggle(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) toggle(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { toggle(false); btn.focus(); }
  });
  initCtaDock(document.querySelector<HTMLElement>('header:has(.cta-dock)'));
</script>
