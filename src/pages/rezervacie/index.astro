---
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import Icon from '../../components/shared/Icon.astro';
import Todo from '../../components/shared/Todo.astro';
import { site, zones, diving, news } from '../../lib/content';
import { priceShort } from '../../lib/format';
import { url } from '../../lib/url';
import { breadcrumbJsonLd } from '../../lib/seo';

const voucherNews = news.items[0];
const how = zones.premium.howBooking;
type Opt = { zone: string; icon: Parameters<typeof Icon>[0]['name']; title: string; text: string; actions: { href: string; label: string; external?: boolean; primary?: boolean }[]; extra?: string };
const options: Opt[] = [
  {
    zone: 'premium', icon: 'bed', title: 'Pobyt v apartmáne alebo v kempe',
    text: `Apartmány č. 1 – 3 a kempingové miesta č. 3 – 7 v Prémium zóne. Apartmán od ${priceShort(79)} za noc, kemping ${priceShort(18)} dospelý za deň.`,
    actions: [
      { href: site.booking.stayPrevio.href, label: 'Online rezervácia (Previo)', external: true, primary: true },
      { href: site.booking.stayForm.href, label: 'Rezervačný formulár', external: true },
    ],
    extra: 'Formulár použite aj na stanovanie v Dive Centre (len pre držiteľov potápačskej licencie).',
  },
  {
    zone: 'dive', icon: 'fish', title: 'Skúšobný zážitkový ponor',
    text: `30 minút s inštruktorom, výstroj aj vstupné v cene, od 12 rokov. ${priceShort(diving.intro.price)}. Dá sa kúpiť aj ako darček.`,
    actions: [{ href: site.booking.introDive.href, label: 'Rezervovať ponor', external: true, primary: true }, { href: url('/potapanie/#skusobny-ponor'), label: 'Čo obsahuje ponor' }],
  },
  {
    zone: 'dive', icon: 'waves', title: 'Potápačský kurz OWD alebo AOWD',
    text: `Základný kurz OWD trvá 3 dni (piatok – nedeľa) a končí licenciou SDI. OWD aj AOWD ${priceShort(diving.course.price)}.`,
    actions: [{ href: site.booking.course.href, label: 'Prihlásiť sa na kurz', external: true, primary: true }, { href: url('/potapanie/#kurz-owd'), label: 'Priebeh kurzu' }],
  },
  {
    zone: 'dive', icon: 'users', title: 'Potápačská alebo freediverská skupina',
    text: 'Skupiny sa registrujú vopred s vyplneným potápačským reverzom za každého účastníka.',
    actions: [{ href: site.booking.groups.href, label: 'Registrovať skupinu', external: true, primary: true }, { href: site.documents[3].href, label: 'Potápačský reverz (PDF)', external: true }],
  },
  {
    zone: 'event', icon: 'flame', title: 'Oslava alebo firemná akcia v Event zóne',
    text: 'Altánky, ohnisko, priestor na stanovanie, kapacita do 100 osôb. Catering, výčapy a technika na objednávku.',
    actions: [{ href: `tel:${site.contacts.info.tel}`, label: `Zavolať ${site.contacts.info.phone}`, primary: true }, { href: `mailto:${site.contacts.info.email}`, label: 'Napísať e-mail' }],
  },
  {
    zone: 'plaz', icon: 'ticket', title: 'Vstup na pláž',
    text: 'Vstupné do Plážovej zóny sa platí pri vstupe do areálu podľa cenníka. Po zaplatení dostanete náramok.',
    actions: [{ href: url('/cennik/#plazova-zona'), label: 'Cenník pláže', primary: true }, { href: url('/otvaracie-hodiny/'), label: 'Otváracie hodiny' }],
  },
];
---
<Site
  title="Rezervácie pobytu, ponorov a kurzov"
  description="Ako si rezervovať pobyt v apartmáne alebo v kempe, skúšobný ponor, potápačský kurz, skupinu alebo oslavu v Aquarea Čierna Voda. Odkazy na rezervačné formuláre a kontakty."
  current="rezervacie"
  jsonLd={breadcrumbJsonLd([{ name: 'Úvod', url: 'https://www.aquarea.sk/' }, { name: 'Rezervácie', url: 'https://www.aquarea.sk/kontakt/rezervacie/' }])}
>
  <PageHero title="Rezervácie" lead="Vyberte, čo chcete rezervovať. Formuláre a online rezervácia zatiaľ bežia na súčasnom webe aquarea.sk." zone="slnko" crumb="Rezervácie" />

  <div class="mx-auto max-w-[90rem] px-4 py-12 md:px-8 md:py-16">
    <ul class="grid gap-4 md:grid-cols-2" role="list">
      {options.map((o) => (
        <li class:list={['flex flex-col rounded-lg border-t-8 bg-v3-siva p-5 md:p-7', `zone-${o.zone} zone-border`]}>
          <div class="flex items-start gap-4">
            <span class="zone-fill grid h-12 w-12 shrink-0 place-items-center rounded-full"><Icon name={o.icon} size={24} /></span>
            <div>
              <h2 class="v3-display text-[1.9rem] leading-[0.95] md:text-[2.3rem]">{o.title}</h2>
              <p class="mt-2">{o.text}</p>
              {o.extra && <p class="mt-2 text-[0.9375rem] text-v3-atrament/80">{o.extra}</p>}
            </div>
          </div>
          <div class="mt-auto flex flex-wrap gap-3 pt-5">
            {o.actions.map((a) => (
              <a href={a.href} target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}
                 class:list={['inline-flex min-h-12 items-center gap-2 rounded-lg px-5 font-extrabold', a.primary ? 'zone-fill' : 'border-2 border-v3-atrament bg-white hover:bg-v3-siva']}>
                {a.label}{a.external && <><Icon name="external" size={18} /><span class="sr-only"> (otvorí aquarea.sk)</span></>}
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-4"><Todo text={site.booking.todo} /></p>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      <section aria-labelledby="ako" class="zone-premium">
        <h2 id="ako" class="v3-display text-[2.4rem] leading-[0.95] md:text-[3.4rem]">Ako prebieha rezervácia pobytu</h2>
        <ol class="mt-5 space-y-3" role="list">
          {how.steps.map((s, i) => (
            <li class="flex gap-4 rounded-lg bg-v3-siva p-4">
              <span class="zone-fill v3-display grid h-10 w-10 shrink-0 place-items-center rounded-full text-[1.4rem] leading-none">{i + 1}</span>
              <span class="pt-1.5">{s}</span>
            </li>
          ))}
        </ol>
        <ul class="v3-prose mt-5 text-[0.9375rem]" role="list"><li>{how.storno}</li><li>{how.voucher}</li><li>{how.checkin}</li></ul>
      </section>
      <aside aria-labelledby="kontakt" class="space-y-4">
        <div class="rounded-lg bg-v3-atrament p-6 text-white">
          <h2 id="kontakt" class="v3-display text-[2rem] leading-[0.95]">Radšej telefonicky?</h2>
          <p class="mt-3 text-sm text-white/75">{site.contacts.info.label}</p>
          <p class="text-2xl font-extrabold"><a class="underline underline-offset-4" href={`tel:${site.contacts.info.tel}`}>{site.contacts.info.phone}</a></p>
          <p><a class="underline underline-offset-4" href={`mailto:${site.contacts.info.email}`}>{site.contacts.info.email}</a></p>
          <p class="mt-4 text-sm text-white/75">{site.contacts.dive.label}</p>
          <p class="text-2xl font-extrabold"><a class="underline underline-offset-4" href={`tel:${site.contacts.dive.tel}`}>{site.contacts.dive.phone}</a></p>
          <p><a class="underline underline-offset-4" href={`mailto:${site.contacts.dive.email}`}>{site.contacts.dive.email}</a></p>
          <ul class="mt-4 space-y-1 text-sm text-white/85" role="list">{site.contacts.info.hours.map((h) => <li>{h}</li>)}</ul>
          <p class="mt-2 text-sm text-white/85">{site.contacts.info.callback}</p>
        </div>
        <div class="rounded-lg border-2 border-v3-atrament p-5">
          <h2 class="font-extrabold">{voucherNews.title}</h2>
          <p class="mt-2 text-[0.9375rem]">{voucherNews.text}</p>
        </div>
      </aside>
    </div>
  </div>
</Site>
