---
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import Photo from '../../components/shared/Photo.astro';
import Icon from '../../components/shared/Icon.astro';
import Todo from '../../components/shared/Todo.astro';
import { fff, site } from '../../lib/content';
import { dateLong } from '../../lib/format';
import { breadcrumbJsonLd } from '../../lib/seo';

// Event JSON-LD is added once the date is confirmed (see TODO); an unconfirmed date must not go into structured data.
---
<Site
  title="FotoFilmFest – podvodná fotografia a film"
  description="Potápačský festival fotografie a filmu v Aquarea Čierna Voda: súťaže fotografie a filmu spod hladiny, súťaž vo fotografovaní pod vodou, propozície a prihlášky."
  current="fff"
  jsonLd={breadcrumbJsonLd([{ name: 'Úvod', url: 'https://www.aquarea.sk/' }, { name: 'FotoFilmFest', url: fff.source }])}
>
  <PageHero title={fff.next.title} lead={fff.fullName} zone="event" photo="pod-vodou-rura" crumb="FotoFilmFest">
    <p class="v3-display mt-5 text-[2rem] leading-[0.95] md:text-[2.8rem]">{dateLong(fff.next.date)}</p>
    <p class="mt-1 font-semibold">{fff.next.evening}. {fff.next.place}.</p>
    <p class="mt-3"><Todo text={fff.next.todo} /></p>
  </PageHero>

  <div class="zone-event mx-auto max-w-[90rem] px-4 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <section aria-labelledby="o-festivale">
        <h2 id="o-festivale" class="v3-display text-[2.4rem] leading-[0.95] md:text-[3.4rem]">O festivale</h2>
        <div class="v3-prose mt-4"><p>{fff.lead}</p><p>{fff.idea}</p></div>
      </section>
      <section aria-labelledby="tim" class="rounded-lg bg-v3-siva p-6">
        <h2 id="tim" class="text-xl font-extrabold">Kto festival robí</h2>
        <dl class="mt-3 space-y-3">
          {fff.team.map((t) => <div><dt class="text-sm font-bold text-v3-atrament/70">{t.role}</dt><dd class="font-semibold">{t.who}</dd></div>)}
        </dl>
        <ul class="mt-4 flex flex-wrap gap-3" role="list">
          {fff.partners.map((p) => <li><a href={p.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 font-semibold underline underline-offset-4">{p.label}<Icon name="external" size={16} /></a></li>)}
        </ul>
      </section>
    </div>

    <section aria-labelledby="sutaze" class="mt-14">
      <h2 id="sutaze" class="v3-display text-[2.4rem] leading-[0.95] md:text-[3.4rem]">Súťaže a propozície</h2>
      <p class="mt-3 max-w-3xl">Propozície sú podľa ročníka 2026 na aquarea.sk. Pre nový ročník ich treba potvrdiť.</p>
      <div class="mt-6 space-y-3">
        {fff.competitions.map((c, i) => (
          <details class="group rounded-lg bg-v3-siva" open={i === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 px-5 py-4 [&::-webkit-details-marker]:hidden">
              <span class="v3-display flex-1 text-[1.7rem] leading-[0.95] md:text-[2.2rem]">{c.title}</span>
              <Icon name="chevron-down" size={26} stroke={2.5} class="shrink-0 transition-transform group-open:rotate-180" />
            </summary>
            <div class="grid gap-6 px-5 pb-6 md:grid-cols-[1fr_2fr]">
              <div>
                <h3 class="font-extrabold">Kategórie</h3>
                <ul class="mt-2 space-y-2" role="list">{c.categories.map((k) => <li class="zone-fill rounded-lg px-3 py-2 font-bold">{k}</li>)}</ul>
              </div>
              <div>
                <h3 class="font-extrabold">Podmienky</h3>
                <ul class="v3-prose mt-2" role="list">{c.points.map((p) => <li>{p}</li>)}</ul>
                <p class="mt-3 text-[0.9375rem] text-v3-atrament/80">{c.deadline2026}</p>
                <a href={c.source} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold underline underline-offset-4">Celé propozície na aquarea.sk<Icon name="external" size={16} /></a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="prihlasky" class="mt-14 grid gap-6 lg:grid-cols-2">
      <div class="zone-fill v3-weave rounded-lg p-6 md:p-8">
        <h2 id="prihlasky" class="v3-display text-[2.2rem] leading-[0.95] md:text-[3rem]">Prihlášky</h2>
        <ul class="mt-5 space-y-3" role="list">
          {fff.applications.map((a) => <li><a href={a.href} target="_blank" rel="noopener" class="flex min-h-14 items-center justify-between gap-3 rounded-lg bg-white px-4 py-3 font-extrabold text-v3-atrament">{a.label}<Icon name="external" size={18} /><span class="sr-only"> (formulár na aquarea.sk)</span></a></li>)}
        </ul>
        <p class="mt-4"><Todo text={fff.applicationsTodo} /></p>
        <p class="mt-4 text-[0.9375rem]">Otázky: <a class="font-bold underline underline-offset-4" href={`mailto:${site.contacts.dive.email}`}>{site.contacts.dive.email}</a>, <a class="font-bold underline underline-offset-4" href={`tel:${site.contacts.dive.tel}`}>{site.contacts.dive.phone}</a></p>
      </div>
      <section aria-labelledby="program" class="rounded-lg bg-v3-siva p-6 md:p-8">
        <h2 id="program" class="text-xl font-extrabold">Program minulého ročníka ({fff.last.dateText})</h2>
        {fff.last.program.map((d) => (
          <div class="mt-4">
            <h3 class="font-extrabold">{d.day}</h3>
            <ol class="mt-2 divide-y divide-v3-atrament/10" role="list">
              {d.items.map((it) => <li class="grid grid-cols-[7.5rem_1fr] gap-3 py-2 text-[0.9375rem]"><span class="font-bold tabular-nums">{it.time}</span><span>{it.text}</span></li>)}
            </ol>
          </div>
        ))}
      </section>
    </section>

    <ul class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4" role="list">
      <li><Photo id="pod-vodou-scuka" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 640]} class="aspect-square w-full rounded-lg object-cover" /></li>
      <li><Photo id="pod-vodou-kapor-konare" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 640]} class="aspect-square w-full rounded-lg object-cover" /></li>
      <li><Photo id="pod-vodou-motorka" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 640]} class="aspect-square w-full rounded-lg object-cover" /></li>
      <li><Photo id="pod-vodou-potapac-atrakcia" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 640]} class="aspect-square w-full rounded-lg object-cover" /></li>
    </ul>
    <p class="mt-2 text-sm text-v3-atrament/70">Fotografie z Dive Centra Aquarea (aquarea.sk), nie súťažné diela.</p>
  </div>
</Site>
