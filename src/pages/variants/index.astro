---
/** Picker for the homepage directions (Phase 2: 1–3, Phase 4: 4–5). Neutral styling on purpose: the directions should speak. */
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import v1d from '../../assets/picker/v1-desktop.png';
import v1m from '../../assets/picker/v1-mobile.png';
import v2d from '../../assets/picker/v2-desktop.png';
import v2m from '../../assets/picker/v2-mobile.png';
import v3d from '../../assets/picker/v3-desktop.png';
import v3m from '../../assets/picker/v3-mobile.png';
import v4d from '../../assets/picker/v4-desktop.png';
import v4m from '../../assets/picker/v4-mobile.png';
import v5d from '../../assets/picker/v5-desktop.png';
import v5m from '../../assets/picker/v5-mobile.png';
import v6d from '../../assets/picker/v6-desktop.png';
import v6m from '../../assets/picker/v6-mobile.png';
import v7d from '../../assets/picker/v7-desktop.png';
import v7m from '../../assets/picker/v7-mobile.png';

const RECOMMENDED = 3; // [auto] pick, see DECISIONS.md

const directions = [
  {
    n: 1, name: 'Ponor', desktop: v1d, mobile: v1m,
    mood: 'Stránka je ponor. Začína na hladine a každá časť je o kus hlbšie. Hĺbkomer vľavo (na mobile hore) ukazuje skutočné atrakcie z mapy Dive Centra: −8 m autobus, −13 m električka, −30 m hlboká plošina. Pozadie postupne tmavne do zelenomodrej hĺbky, v časti o Dive Centre dopadajú slnečné lúče.',
    palette: [['hladina', '#ddf3f1'], ['tyrkys', '#1fa7a6'], ['jazero', '#0f6e86'], ['hĺbka', '#0a3f52'], ['dno', '#06232e'], ['slnko', '#f4c542']],
    type: 'Archivo (jedna rodina, rozšírené rezy na nadpisy a hĺbky)',
    signature: 'hĺbkomer so skutočnými hĺbkami, graf „čo leží v akej hĺbke“, pás fotografií spod hladiny so zaostrením na strednú',
  },
  {
    n: 2, name: 'Deň pri vode', desktop: v2d, mobile: v2m,
    mood: 'Letný časopis na bielom papieri s modrým „atramentom“ namiesto čiernej. Veľké pätkové nadpisy, fotografie s kurzívnymi popiskami, asymetrické dvojstrany pre pláž, pobyt a potápanie. Cenník je vysádzaný ako rámček v časopise.',
    palette: [['papier', '#ffffff'], ['atrament', '#123e5c'], ['obloha', '#dceef7'], ['pšenica', '#e2b547'], ['slnečník', '#c8102e'], ['tráva', '#2f6b3a']],
    type: 'Newsreader (nadpisy, popisky) + Instrument Sans (texty, ovládanie)',
    signature: 'pás „Od rána do západu slnka“: skutočné fotografie dňa pri jazere naviazané na otváracie hodiny hlavnej sezóny, s lightboxom',
  },
  {
    n: 3, name: 'Náramok', desktop: v3d, mobile: v3m,
    mood: 'Výrazný, športový, farebne kódovaný ako značenie v areáli. Každá zóna má farbu a vystupuje ako náramok (areál naozaj pracuje s náramkami pre zóny). Ťuknutím sa náramok otvorí: čo tam je, koľko to stojí, tlačidlo na rezerváciu. Ceny sú veľké číslice ako na tabuli pri pokladni.',
    palette: [['biela', '#ffffff'], ['atrament', '#10212b'], ['pláž', '#00a3a3'], ['prémium', '#2e7d32'], ['dive', '#0b4f8a'], ['event', '#d62828'], ['slnko', '#ffc93c']],
    type: 'Big Shoulders Display (úzke kapitálky) + Figtree',
    signature: 'zóny ako farebné náramky, sezónna tabuľa po mesiacoch, cenová tabuľa, bežiace logá partnerov',
  },
  {
    n: 4, name: 'Čierna voda', desktop: v4d, mobile: v4m,
    mood: 'Jazero v noci a vy držíte potápačskú baterku. Celú stránku podkladá čierna hladina vo WebGL s vlnkami, kaustikami a zábleskami. Kužeľ svetla ukazuje skutočné fotografie spod vody a ožívajú len v ňom. Kliknutím alebo ťuknutím pustíte do vody kruhy. Na mobile svetlo putuje samo, kým ho nepotiahnete prstom. Ceny, hodiny a tlačidlá sú čitateľné aj potme, svetlo ich len zohreje.',
    palette: [['atrament', '#05070b'], ['hĺbka', '#0a1018'], ['studená', '#8796aa'], ['hmla', '#d6dee8'], ['baterka', '#fff1d6'], ['bója', '#ff5a1f']],
    type: 'Syne (nadpisy, písmená sa vynárajú z vody) + Geist (texty a čísla)',
    signature: 'WebGL hladina s baterkou, skutočné fotografie v kuželi svetla, morský sneh, vlnky z dotyku, svetlo zhasne a zažne pri každej časti',
    note: 'Smelý koncept s výnimkou z prístupnosti a Lighthouse (rozhodnutie vlastníka). Pred použitím na ostrom webe treba úpravy.',
  },
  {
    n: 5, name: 'Titulky', desktop: v5d, mobile: v5m,
    mood: 'Domovská stránka ako úvodné titulky filmu. Krátke odpočítavanie 3-2-1, potom titulná karta. Každá časť je scéna s vlastnou sýtou farbou a strihom (clona, žalúzie, tvrdý strih). Obrovské písmo sa pri rolovaní zužuje, rozťahuje a naráža do seba. Cenník beží ako záverečné titulky, otváracie hodiny sú filmové hodiny, FotoFilmFest je klapka a galéria filmový pás.',
    palette: [['ultramarín', '#2a2af5'], ['citrón', '#f4e234'], ['signál', '#ff5f1f'], ['ružová', '#ff3e8a'], ['film', '#121010'], ['papier', '#f4f4f2']],
    type: 'Anybody (variabilná šírka 50–150 %) + Hanken Grotesk',
    signature: 'strihy medzi scénami, kinetické písmo na osi šírky, časový kód podľa rolovania, filmový pás s premietaním vo farbe, duotón a raster na fotografiách',
    note: 'Smelý koncept s výnimkou z prístupnosti a Lighthouse (rozhodnutie vlastníka). Pred použitím na ostrom webe treba úpravy.',
  },
  {
    n: 6, name: 'Čistá voda', desktop: v6d, mobile: v6m,
    mood: 'Svetlá, vzdušná a presná, ako pohľad cez čistú vodu. Na prvej obrazovke mobilu je všetko podstatné: čo Aquarea je, ceny, dnešný stav a tlačidlá Rezervovať a Zavolať. Svetlo sa hýbe len vo fotografii v úvode, informácie stoja. Potápanie má jeden hlboký tmavý pás. Spĺňa prístupnosť aj Lighthouse a funguje aj bez JavaScriptu.',
    palette: [['svetlo', '#f5fafa'], ['plytčina', '#e3f1f0'], ['hĺbka', '#0d2830'], ['tlmená', '#43606a'], ['tyrkys', '#159c97'], ['stolička', '#c8352a']],
    type: 'Bricolage Grotesque (nadpisy, optická veľkosť) + Atkinson Hyperlegible Next (texty)',
    signature: 'svetlo z vody (kaustiky) len vo fotografii v úvode s jemným vlnením pod prstom a tlačidlom na zastavenie; drobné animácie: odhaľovanie, počítadlá, galéria s filtrom a lightboxom',
  },
  {
    n: 7, name: 'Rýchla voda', desktop: v7d, mobile: v7m,
    mood: 'Odvážna a športová, no stále čitateľná. Úvod je skutočná letecká fotografia jazera, na nej plavúci potápač, vpravo plný tmavý panel so šikmým rezom s nadpisom, cenami, dnešným stavom a tlačidlami Rezervovať a Zavolať. Text nikdy nestojí na pohybujúcej sa vode. Ďalej ploché farebné pásy vo farbách loga (modrá, čierna, červená) so šikmými hranami, obrovské číslice cien a nálepky len so skutočnými údajmi. Spĺňa prístupnosť aj Lighthouse a funguje aj bez JavaScriptu.',
    palette: [['modrá z loga', '#00a8f0'], ['hlboká modrá', '#006b99'], ['červená z loga', '#d80018'], ['čierna', '#181818'], ['hladina', '#f0faff'], ['biela', '#ffffff']],
    type: 'Barlow Condensed (nadpisy, kurzíva, ťažký rez) + Barlow (texty)',
    signature: 'fotorealistický potápač (vrstvy: nohy kopú okolo bedier, telo sa vlní a pohupuje) nad skutočnou dronovou fotografiou s jemným svetlom a bublinami; sleduje prst alebo kurzor, ťuknutie vyvolá bubliny; tlačidlo na zastavenie a spustenie, aj pri obmedzenom pohybe',
    note: 'Potápač je vygenerovaný obrázok bez skutočnej osoby, značiek a certifikátov (výnimka vlastníka z pravidla 5 pre smer 7). Pozadie je skutočná fotografia z aquarea.sk.',
  },
];
---
<Base title="Smery domovskej stránky" description="Výber vizuálneho smeru pre redizajn webu Aquarea Čierna Voda." bodyClass="bg-[#f5f6f7] text-[#16202a]" themeColor="#f5f6f7">
  <main id="obsah" class="mx-auto max-w-6xl px-4 py-10 font-sans md:px-8 md:py-16">
    <p class="text-sm font-semibold text-[#4b5866]">Aquarea Čierna Voda, koncept redizajnu</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight md:text-5xl">Sedem smerov domovskej stránky</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[#35424f]">
      Všetkých sedem používa rovnaký skutočný obsah z aquarea.sk (ceny, hodiny, kontakty, fotografie) a rovnakú novú štruktúru webu. Líšia sa náladou, typografiou a hlavným efektom. Na mobile majú všetky spodnú lištu Zavolať / Rezervovať / Navigovať. Smery 4 a 5 sú najodvážnejšie, postavené na pohybe. Smer 6 je pohyb v službe čitateľnosti a rezervácie. Smer 7 je odvážny a športový, ale s rovnakou prísnosťou na prístupnosť.
    </p>
    <ol class="mt-12 space-y-16" role="list">
      {directions.map((d) => (
        <li class="grid gap-6 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 md:p-8 lg:grid-cols-[1fr_1.15fr] lg:gap-10">
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-2xl font-bold md:text-3xl">Smer {d.n}: {d.name}</h2>
              {RECOMMENDED === d.n && <span class="rounded-full bg-[#16202a] px-3 py-1 text-sm font-semibold text-white">Odporúčaný smer</span>}
            </div>
            <p class="mt-4 leading-relaxed text-[#35424f]">{d.mood}</p>
            {'note' in d && <p class="mt-3 rounded-lg bg-[#fff1c2] px-3 py-2 text-sm text-[#4a3200]">{d.note}</p>}
            <dl class="mt-5 space-y-3 text-[0.9375rem]">
              <div><dt class="font-semibold">Písmo</dt><dd class="text-[#35424f]">{d.type}</dd></div>
              <div><dt class="font-semibold">Hlavný efekt</dt><dd class="text-[#35424f]">{d.signature}</dd></div>
              <div>
                <dt class="font-semibold">Farby</dt>
                <dd class="mt-2 flex flex-wrap gap-2">
                  {d.palette.map(([name, hex]) => (
                    <span class="inline-flex items-center gap-2 rounded-full bg-[#f5f6f7] py-1 pl-1 pr-3 text-sm"><span class="h-5 w-5 rounded-full ring-1 ring-black/15" style={`background:${hex}`}></span>{name}</span>
                  ))}
                </dd>
              </div>
            </dl>
            <a href={url(`/variants/${d.n}/`)} class="mt-6 inline-flex min-h-12 items-center rounded-full bg-[#16202a] px-6 font-semibold text-white hover:bg-[#2c3a48]">Otvoriť smer {d.n}: {d.name}</a>
          </div>
          <a href={url(`/variants/${d.n}/`)} class="grid grid-cols-[1fr_auto] items-end gap-3 rounded-xl" aria-label={`Náhľad smeru ${d.n}: ${d.name}`}>
            <Image src={d.desktop} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 70vw" class="w-full rounded-lg ring-1 ring-black/10" />
            <Image src={d.mobile} alt="" widths={[160, 240, 320]} sizes="(min-width: 1024px) 9vw, 24vw" class="w-[24vw] max-w-[9.5rem] rounded-lg ring-1 ring-black/10" />
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-14 text-sm text-[#4b5866]">Koncept, neoficiálna verzia, neindexuje sa. Obsah, fotografie a logo © AQUAREA s.r.o.</p>
  </main>
</Base>
