                  <span class="min-w-0 flex-1"><span class="block font-bold">{f.title}</span><span class="block text-[0.9375rem] text-v1-hladina">{f.note}</span></span>
                  <Icon name="external" size={18} class="shrink-0 text-v1-hladina" /><span class="sr-only"> (otvorí aquarea.sk)</span>
