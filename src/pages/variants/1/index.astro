            ))}
          </ul>
          <p class="mt-3"><Todo text={site.booking.todo} /></p>
          <p class="mt-6 text-v1-hladina">Radšej telefonicky? <a class="font-bold text-white underline underline-offset-4" href={`tel:${site.contacts.info.tel}`}>{site.contacts.info.phone}</a> · Dive Center <a class="font-bold text-white underline underline-offset-4" href={`tel:${site.contacts.dive.tel}`}>{site.contacts.dive.phone}</a></p>
        </div>
        <div>
          <h2 class="v1-display text-[1.75rem] leading-tight text-white">Ako sa k nám dostať</h2>
          <p class="mt-3 text-v1-hladina">{site.gettingThere.text}</p>
          <div class="mt-5 overflow-hidden rounded-3xl bg-white p-2">
            <Photo id="mapa-arealu" sizes="(min-width: 1024px) 40vw, 100vw" widths={[480, 800, 1200]} class="w-full rounded-2xl" />
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={site.maps.directions} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-full bg-v1-slnko px-6 font-bold text-v1-dno hover:bg-white"><Icon name="navigation" size={20} />Navigovať<span class="sr-only"> (Google Mapy)</span></a>
            <a href={site.documents[1].href} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-white/60 px-6 font-bold text-white hover:bg-white/10"><Icon name="file" size={20} />Mapa areálu (PDF)</a>
          </div>
