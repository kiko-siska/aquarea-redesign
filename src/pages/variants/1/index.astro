    </section>
  </main>

  <Footer />
  <StickyCta bookHref={book} class="border-t border-v1-ink/10 bg-v1-pena/95 backdrop-blur" itemClass="text-v1-ink" primaryClass="bg-v1-slnko text-v1-dno" />
  <StatusScript />
</Base>

<style is:global>
  .v1 { --focus-color: #f4c542; }
  .v1 .v1-display { font-family: var(--font-v1); font-weight: 800; font-stretch: 125%; letter-spacing: -0.02em; text-wrap: balance; }
  .v1 main :is(p, li) { text-wrap: pretty; }
  .v1-sec { background: linear-gradient(to bottom, var(--from), var(--to)); }
  .v1-dark { color: #ddf3f1; --focus-color: #f4c542; }
  .v1-header :focus-visible, .v1-sec:not(.v1-dark) :focus-visible { --focus-color: #0a3f52; }
  .v1-thermocline { height: 7rem; background: linear-gradient(to bottom, #4fbab5, #0f6e86); }
  .v1-caustics {
    position: absolute; inset: auto 0 0 0; height: 45%; width: 100%; object-fit: cover; pointer-events: none;
    mix-blend-mode: soft-light; opacity: 0.55;
    mask-image: linear-gradient(to bottom, transparent, #000 60%);
  }

  /* depth gauge */
  .v1-gauge { position: fixed; z-index: 30; pointer-events: none; }
  .v1-gauge-rail { display: none; }
  .v1-gauge-readout {
    display: flex; align-items: baseline; gap: 0.5rem; margin: 0;
    padding: 0.35rem 0.8rem; border-radius: 999px; background: rgb(6 35 46 / 0.82); color: #fff;
    font-size: 0.8125rem; backdrop-filter: blur(6px);
  }
  .v1-gauge-depth { font-weight: 800; font-stretch: 125%; font-variant-numeric: tabular-nums; font-size: 1rem; }
  .v1-gauge-label { color: #ddf3f1; }
  .v1-gauge { top: 4.6rem; right: 0.75rem; transition: opacity .3s; }
  .v1-gauge[data-surface] { opacity: 0; }
  @media (min-width: 1280px) {
    .v1-gauge[data-surface] { opacity: 1; }
    .v1-gauge { top: 7rem; bottom: 2rem; left: 1rem; right: auto; width: 4.75rem; display: flex; flex-direction: column; gap: 1rem; }
    .v1-gauge-rail { display: block; position: relative; flex: 1; width: 2px; margin-left: 0.5rem; background: linear-gradient(#1fa7a6, #06232e); border-radius: 2px; }
    .v1-gauge-tick { position: absolute; top: var(--t); left: -4px; width: 10px; height: 2px; background: currentColor; color: #0a3f52; }
    .v1-gauge-tick span { position: absolute; left: 16px; top: -0.55rem; font-size: 0.75rem; font-weight: 700; font-stretch: 112%; color: #0a3f52; background: rgb(244 251 250 / 0.85); padding: 0 0.25rem; border-radius: 4px; }
    .v1-gauge-marker { position: absolute; left: -7px; top: 0; width: 16px; height: 16px; border-radius: 50%; background: #f4c542; box-shadow: 0 0 0 4px rgb(244 197 66 / 0.3); transition: top 0.5s cubic-bezier(.22,1,.36,1); }
    .v1-gauge-readout { flex-direction: column; align-items: flex-start; gap: 0.1rem; border-radius: 0.75rem; padding: 0.5rem 0.6rem; font-size: 0.75rem; line-height: 1.2; }
    .v1-gauge-depth { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .v1-gauge-marker { transition: none; } }
</style>

<script>
  // Depth gauge: follows the chapter in the middle of the screen.
  const depthEl = document.querySelector<HTMLElement>('[data-gauge-depth]');
  const labelEl = document.querySelector<HTMLElement>('[data-gauge-label]');
  const marker = document.querySelector<HTMLElement>('[data-gauge-marker]');
  const secs = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const d = Number((e.target as HTMLElement).dataset.depth);
      if (depthEl) depthEl.textContent = d === 0 ? '0 m' : `−${d} m`;
      if (labelEl) labelEl.textContent = (e.target as HTMLElement).dataset.depthLabel ?? '';
      if (marker) marker.style.top = `calc(${(d / 36) * 100}% - 8px)`;
      document.querySelector('[data-gauge]')?.toggleAttribute('data-surface', d === 0);
    }
  }, { rootMargin: '-45% 0px -45% 0px' });
  secs.forEach((s) => io.observe(s));
</script>
